{
  "name": "markdown-viewer",
  "productName": "Marquellium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
